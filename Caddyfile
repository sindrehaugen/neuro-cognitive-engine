# TriMCP v1.0 — Edge Proxy Configuration (Caddyfile)

{
	# Disable Caddy's admin API for security hardening
	admin off
	# Preserve plain HTTP on :80 for container healthchecks while serving TLS on :443
	auto_https disable_redirects
}

# Bind to HTTP and HTTPS with internal TLS termination
http://:80, https://localhost:443, https://127.0.0.1:443 {
	# Internal self-signed TLS termination for HTTPS
	tls internal

	# Security Headers
	header {
		# Clickjacking protection
		X-Frame-Options "DENY"
		# MIME-type sniffing protection
		X-Content-Type-Options "nosniff"
		# Cross-Site Scripting (XSS) protection disabled in favor of strict CSP (OWASP recommendation)
		X-XSS-Protection "0"
		# Prevent referrer information leak
		Referrer-Policy "strict-origin-when-cross-origin"
		# Restrict browser feature access
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# Content Security Policy (strict by default, allowing local resources)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self';"
		# Hide the server signature
		-Server
	}

	# Global request size limit to prevent resource exhaustion (20 MB default)
	request_body {
		max_size 20971520
	}

	# Route webhooks to the receiver
	handle /webhooks/* {
		# Limit webhook payload size to 1MB (matches WEBHOOK_MAX_BODY_BYTES)
		request_body {
			max_size 1048576
		}
		reverse_proxy webhook-receiver:8080 {
			# Sanitize proxy headers to prevent client-side IP spoofing
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Route A2A protocol endpoints to dedicated a2a service
	@a2a_routes path /tasks/* /.well-known/agent-card
	handle @a2a_routes {
		reverse_proxy a2a:8004 {
			# Sanitize proxy headers to prevent client-side IP spoofing
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Route Streamable HTTP MCP gateway endpoints with unbuffered SSE streaming
	@mcp_routes path /mcp /mcp/*
	handle @mcp_routes {
		reverse_proxy mcp-gateway:8005 {
			flush_interval -1
			# Sanitize proxy headers to prevent client-side IP spoofing
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Optional vertical engine upstreams (resolved dynamically so Core-only stacks start cleanly)
	vars portal_upstream "portal:8010"
	vars odoo_upstream "odoo:8011"
	vars salesforce_upstream "salesforce:8012"

	# Optional vertical engine routes (active when docker-compose.verticals.yml is attached)
	handle /api/portal/* {
		reverse_proxy {vars.portal_upstream} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle_path /portal/* {
		reverse_proxy {vars.portal_upstream} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle_path /odoo/* {
		reverse_proxy {vars.odoo_upstream} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle_path /salesforce/* {
		reverse_proxy {vars.salesforce_upstream} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Edge proxy health probe (independent of upstream app state)
	handle /caddy-healthz {
		respond "ok" 200
	}

	# Route everything else to the Admin UI / REST API
	handle {
		reverse_proxy admin:8003 {
			# Sanitize proxy headers to prevent client-side IP spoofing
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}

