# /etc/nce/nce.env — Host environment file for NCE server daemon and Compose stack
# 
# To initialize secrets, run as root/administrator:
#   python3 /opt/nce/scripts/bootstrap-compose-secrets.py --env /etc/nce/nce.env
#
# Reference defaults: /opt/nce/deploy/compose.stack.env.example

# Service deployment mode (must be multiuser)
NCE_MODE=multiuser
NCE_APP_ROOT=/opt/nce

# System install signal
NCE_SYSTEM_INSTALL=1

# Extractor Integrity Hash (compute via: sha256sum $(which soffice))
# NCE_SOFFICE_HASH=

# Backing store endpoints (Docker Compose internal network defaults)
MONGO_URI=mongodb://mongodb:27017
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Core Security Keys (Generate 32+ char random strings via bootstrap script)
NCE_MASTER_KEY=REPLACE_ME_RUN_bootstrap_compose_secrets_32CHARS_MIN
NCE_API_KEY=REPLACE_ME_RUN_bootstrap_compose_secrets
NCE_JWT_SECRET=REPLACE_ME_RUN_bootstrap_compose_secrets_32CHARS_MIN

# Admin Console Credentials
NCE_ADMIN_USERNAME=admin
NCE_ADMIN_PASSWORD=REPLACE_ME_RUN_bootstrap_compose_secrets

# Single tenant default namespace
NCE_MCP_NAMESPACE_ID=00000000-0000-4000-8000-000000000001
