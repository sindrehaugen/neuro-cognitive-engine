[Unit]
Description=Neuro-Cognitive Engine (NCE) Multiuser Server Stack
Documentation=https://github.com/sindrehaugen/NCE
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nce

# Security & Privilege Fact:
# The service runs as user 'nce' (group 'nce'). To communicate with the Docker daemon via
# /var/run/docker.sock, the 'nce' user must be added to the host 'docker' group.
# Note: On Linux systems, membership in the 'docker' group is effectively root-equivalent.
User=nce
Group=nce

EnvironmentFile=-/etc/nce/nce.env

ExecStart=/usr/bin/docker compose -f /opt/nce/deploy/multiuser/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/nce/deploy/multiuser/docker-compose.yml down

# Sandbox and Filesystem Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nce /var/log/nce

# Lifecycle timeouts for container pull/up/down
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
