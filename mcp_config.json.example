{
  "mcpServers": {
    "nce-http": {
      "url": "https://localhost:8443/mcp",
      "headers": {
        "Authorization": "Bearer nce_mcp_REPLACE_WITH_SCOPED_TOKEN"
      }
    },
    "nce-proxy": {
      "command": "python",
      "args": [
        "-m",
        "nce.mcp_client_proxy"
      ],
      "env": {
        "NCE_MCP_HTTP_URL": "https://localhost:8443/mcp",
        "NCE_MCP_CLIENT_TOKEN": "nce_mcp_REPLACE_WITH_SCOPED_TOKEN"
      }
    }
  }
}
